/**
 * This class represents a maze using an adjacency matrix.
 *
 * @author Kevin Munoz-Rivera
 * @version Summer 2026
 */
public class Maze {

    /**
     * This class represents a vertex in the maze.
     */
    public class Vertex implements Comparable<Vertex> {

        /**
         * The vertex number.
         */
        public int id;

        /**
         * The row of the vertex.
         */
        public int row;

        /**
         * The column of the vertex.
         */
        public int column;

        /**
         * Whether the vertex has been visited.
         */
        public boolean visited;

        /**
         * Whether the vertex is part of the solved path.
         */
        public boolean solved;

        /**
         * Constructs a vertex.
         *
         * @param id the vertex number
         * @param row the row
         * @param column the column
         */
        public Vertex(final int id, final int row,
                      final int column) {
            this.id = id;
            this.row = row;
            this.column = column;
            visited = false;
            solved = false;
        }

        /**
         * Compares this vertex to another vertex.
         *
         * @param other the other vertex
         * @return the comparison result
         */
        @Override
        public int compareTo(final Vertex other) {
            return Integer.compare(id, other.id);
        }
    }

    /**
     * The width of the maze.
     */
    private int width;

    /**
     * The height of the maze.
     */
    private int height;

    /**
     * Stores the vertices of the maze.
     */
    private ArrayList<Vertex> vertices;

    /**
     * Stores the complete grid graph.
     */
    private boolean[][] graph;

    /**
     * Stores the generated maze.
     */
    private boolean[][] maze;

    /**
     * Used to randomly select vertices.
     */
    private Random random;

    /**
     * Constructs a maze.
     *
     * @param width the width
     * @param height the height
     */
    public Maze(final int width, final int height) {
        this.width = width;
        this.height = height;
        int size = this.width * this.height;

        random = new Random();
        graph = new boolean[size][size];
        maze = new boolean[size][size];

        vertices = new ArrayList<Vertex>();

        buildVertex();
        buildGraph();
        buildMaze();
        solveMaze();
    }

    /**
     * Builds the vertices in the graph.
     */
    private void buildVertex() {
        for (int row = 0; row < height; row++) {
            for (int col = 0; col < width; col++) {
                int id = row * width + col;
                vertices.add(id, new Vertex(id, row, col));
            }
        }
    }

    /**
     * Builds the initial grid graph.
     */
    private void buildGraph() {
        for (int row = 0; row < height; row++) {
            for (int col = 0; col < width; col++) {
                int id = row * width + col;

                if (col + 1 < width) {
                    int right = id + 1;

                    graph[id][right] = true;
                    graph[right][id] = true;
                }

                if (row + 1 < height) {
                    int bottom = id + width;

                    graph[id][bottom] = true;
                    graph[bottom][id] = true;
                }
            }
        }
    }

    /**
     * Builds the random maze.
     */
    private void buildMaze() {
        if (vertices.isEmpty()) {
            return;
        }

        buildMaze(vertices.get(0));
    }

    /**
     * Recursively builds the maze from the specified vertex.
     *
     * @param current the current vertex
     */
    private void buildMaze(final Vertex current) {
        current.visited = true;

        ArrayList<Vertex> neighbors = new ArrayList<Vertex>();

        for (int i = 0; i < vertices.size(); i++) {
            if (graph[current.id][i]) {
                neighbors.add(vertices.get(i));
            }
        }

        while (!neighbors.isEmpty()) {
            int randInd = random.nextInt(neighbors.size());

            Vertex next = neighbors.remove(randInd);

            if (!next.visited) {
                maze[current.id][next.id] = true;
                maze[next.id][current.id] = true;

                buildMaze(next);
            }
        }
    }

    /**
     * Solves the maze from the entrance to the exit.
     */
    private void solveMaze() {
        resetVisit();
        solveMaze(vertices.get(0));
    }

    /**
     * Resets the visited status of each vertex.
     */
    private void resetVisit() {
        for (int i = 0; i < vertices.size(); i++) {
            vertices.get(i).visited = false;
        }
    }

    /**
     * Recursively searches for the solution path through the maze.
     *
     * @param current the current vertex
     * @return true if the exit is reached, false otherwise
     */
    private boolean solveMaze(final Vertex current) {
        current.visited = true;

        if (current.id == vertices.size() - 1) {
            current.solved = true;
            return true;
        }

        for (int i = 0; i < vertices.size(); i++) {
            if (maze[current.id][i] && !vertices.get(i).visited) {
                if (solveMaze(vertices.get(i))) {
                    current.solved = true;
                    return true;
                }
            }
        }

        return false;
    }

    /**
     * Returns a string representation of the maze.
     *
     * @return the maze
     */
    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();

        int displayHeight = height * 2 + 1;
        int displayWidth = width * 2 + 1;

        for (int row = 0; row < displayHeight; row++) {
            for (int col = 0; col < displayWidth; col++) {

                // Outer border
                if (row == 0
                        || row == displayHeight - 1
                        || col == 0
                        || col == displayWidth - 1) {

                    // Entrance
                    if (row == 0 && col == 1) {
                        sb.append("+");

                        // Exit
                    } else if (row == displayHeight - 1
                            && col == displayWidth - 2) {

                        sb.append("+");

                    } else {
                        sb.append("X");
                    }

                    // Actual vertex
                } else if (row % 2 == 1 && col % 2 == 1) {

                    int vertexRow = row / 2;
                    int vertexCol = col / 2;

                    int id = vertexRow * width + vertexCol;

                    Vertex current = vertices.get(id);

                    if (current.solved) {
                        sb.append("+");
                    } else {
                        sb.append(" ");
                    }

                    // Horizontal passage
                } else if (row % 2 == 1 && col % 2 == 0) {

                    int vertexRow = row / 2;

                    int leftCol = col / 2 - 1;
                    int rightCol = col / 2;

                    int leftId = vertexRow * width + leftCol;
                    int rightId = vertexRow * width + rightCol;

                    Vertex left = vertices.get(leftId);
                    Vertex right = vertices.get(rightId);

                    if (!maze[leftId][rightId]) {
                        sb.append("X");

                    } else if (left.solved && right.solved) {
                        sb.append("+");

                    } else {
                        sb.append(" ");
                    }

                    // Vertical passage
                } else if (row % 2 == 0 && col % 2 == 1) {

                    int vertexCol = col / 2;

                    int topRow = row / 2 - 1;
                    int bottomRow = row / 2;

                    int topId = topRow * width + vertexCol;
                    int bottomId = bottomRow * width + vertexCol;

                    Vertex top = vertices.get(topId);
                    Vertex bottom = vertices.get(bottomId);

                    if (!maze[topId][bottomId]) {
                        sb.append("X");

                    } else if (top.solved && bottom.solved) {
                        sb.append("+");

                    } else {
                        sb.append(" ");
                    }

                    // Wall intersection
                } else {
                    sb.append("X");
                }
            }

            sb.append("\n");
        }

        return sb.toString();
    }

    public ArrayList<Vertex> getVertices() { return vertices; }

    public int getWidth() { return width; }

    public boolean[][] getMaze() { return maze; }
}
